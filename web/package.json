{
  "name": "silt-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Silt in the browser: the plug-in's own sound (WebAssembly) and panel",
  "scripts": {
    "assets": "sh scripts/assets.sh",
    "dev": "sh scripts/assets.sh --quiet && vite --port 5176 --strictPort",
    "build": "sh scripts/assets.sh && vite build && rm -rf dist/brood-loops",
    "check": "node app/check-exports.mjs ../build-web",
    "test:interact": "node scripts/interact-test.mjs",
    "test:fit": "node scripts/text-fit.mjs",
    "test:phone": "node scripts/phone-test.mjs",
    "test:fit:phone": "PHONE=1 node scripts/text-fit.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "^1.65.1",
    "vite": "6.4.6"
  }
}
